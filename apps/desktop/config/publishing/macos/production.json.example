{
  "bucket": "qinglion",
  "origin": "https://download.qingclaw.com",
  "credentialsFile": "/absolute/path/to/packaging/secrets/oss-production.json",
  "storage": {
    "provider": "aliyun-oss",
    "region": "oss-cn-hangzhou"
  },
  "cache": {
    "provider": "none"
  },
  "macOS": {
    "signingIdentity": "REPLACE_WITH_DEVELOPER_ID_APPLICATION_IDENTITY",
    "teamId": "XXXXXXXXXX"
  },
  "githubApp": {
    "clientId": "REPLACE_WITH_GITHUB_APP_CLIENT_ID",
    "privateKeyFile": "/absolute/path/to/packaging/publishing/keys/desktop-release-tagger.pem"
  }
}

{
  "bucket": "qinglion",
  "origin": "https://download.qingclaw.com",
  "credentialsFile": "C:/absolute/path/to/packaging/secrets/oss-production.json",
  "storage": {
    "provider": "aliyun-oss",
    "region": "oss-cn-hangzhou"
  },
  "cache": {
    "provider": "none"
  },
  "windows": {
    "certificateThumbprint": "0000000000000000000000000000000000000000"
  },
  "githubApp": {
    "clientId": "REPLACE_WITH_GITHUB_APP_CLIENT_ID",
    "privateKeyFile": "C:/absolute/path/to/packaging/publishing/keys/desktop-release-tagger.pem"
  }
}
